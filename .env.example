# Supabase Connection Settings
# Client (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server (SSR / Server functions / Admin API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Email Delivery for Finance 2FA OTP (choose Option A: Outlook/SMTP OR Option B: Resend)
# Option A: Outlook / Microsoft 365 / Custom SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cafeteria@yourdomain.com
SMTP_PASS=your-outlook-app-or-smtp-password
SMTP_FROM="CGCC Cafeteria Express <cafeteria@yourdomain.com>"

# Option B: Resend API (alternative to SMTP)
# RESEND_API_KEY=re_your_resend_api_key
# MAIL_FROM="CGCC Cafeteria Express <noreply@yourdomain.com>"